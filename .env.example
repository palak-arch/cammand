# Copy this file to .env.local and adjust as needed.

# Base URL of your FastAPI backend (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "false" to talk to the real API instead of the bundled mock data.
# Any other value (or leaving it unset) serves mock data.
VITE_USE_MOCK=true